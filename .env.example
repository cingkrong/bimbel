# ==========================================
# DATABASE & CACHE
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/edtech_db?schema=public"
REDIS_URL="redis://localhost:6379"

# ==========================================
# APP DOMAINS & SITES
# ==========================================
NEXT_PUBLIC_APP_URL="https://app.loloskampus.com"
NEXT_PUBLIC_ROOT_DOMAIN="loloskampus.com"

# ==========================================
# AUTH & SESSION ENCRYPTION
# ==========================================
SESSION_SECRET="super-secret-key-at-least-32-characters-long"
ADMIN_SESSION_SECRET="another-super-secret-key-for-admin-auth"

# ==========================================
# NOTIFIKASI WHATSAPP OFFICIAL (META CLOUD API)
# ==========================================
META_WA_ACCESS_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
META_WA_BUSINESS_ACCOUNT_ID=""

# ==========================================
# NOTIFIKASI WHATSAPP UNOFFICIAL (GATEWAY / FONNTE / BION)
# ==========================================
UNOFFICIAL_WA_PROVIDER="BION_GATEWAY"
BION_WA_GATEWAY_URL="http://localhost:3105/api/send"
BION_WA_GATEWAY_API_KEY=""

# ==========================================
# NOTIFIKASI EMAIL (RESEND / SMTP)
# ==========================================
EMAIL_PROVIDER="RESEND" # "RESEND" atau "SMTP"
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LolosKampus Official <noreply@loloskampus.com>"

# ==========================================
# PAYMENT GATEWAY 1: DUITKU
# ==========================================
DUITKU_MERCHANT_CODE=""
DUITKU_API_KEY=""
DUITKU_ENV="sandbox" # "sandbox" atau "production"

# ==========================================
# PAYMENT GATEWAY 2: MIDTRANS
# ==========================================
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# PAYMENT GATEWAY 3: BIONPAY (DUAL-MERCHANT QRIS)
# Docs Swagger: https://orbit.bion.id/docs
# ==========================================
BIONPAY_BASE_URL="https://orbit.bion.id" # atau "http://localhost:3000"
BIONPAY_API_KEY="bp_live_xxxxxxxxxxxxxxxx"
BIONPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
BIONPAY_DEFAULT_PROVIDER="AUTO" # "AUTO", "GOPAY", "SHOPEEPAY"

# ==========================================
# STORAGE (CLOUDFLARE R2 / AWS S3)
# ==========================================
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME="edtech-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN="https://assets.loloskampus.com"

# ==========================================
# CLOUDFLARE FOR SAAS (CUSTOM DOMAIN AUTOMATION)
# ==========================================
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

